# Directory containing earth_fix.dat, earth_awy.dat, earth_aptmeta.dat.
# Defaults to the repo root if unset.
NAVDATA_DIR=

PORT=3000

# Minimum milliseconds between VATSIM datafeed polls. Do not set below 180000
# (180s) -- that is VATSIM's stated rate limit for this endpoint.
VATSIM_POLL_MS=180000

# How long after a flight's last known ETOP has passed before it is dropped
# from tracking (milliseconds).
EXCLUSION_GRACE_MS=3600000
